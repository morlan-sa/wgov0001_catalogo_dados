# Relativo — proxied para o backend (vite.config.ts em dev, nginx.conf em
# prod). Tanto as chamadas de negócio (src/lib/api.ts) quanto as de auth
# (@morlan/access-web) dependem de mesma origem para o cookie de sessão
# funcionar — não troque por uma URL absoluta cross-origin.
VITE_API_URL=/api
# Só usado pelo Vite dev server (server.proxy em vite.config.ts) para saber
# para onde encaminhar /api em `npm run dev` — nunca vai ao browser. Ajuste
# se a API rodar em outra porta/host fora do docker compose.
API_PROXY_TARGET=http://localhost:8000

# Defaults do TanStack QueryClient global (ver src/lib/query-client.ts)
VITE_QUERY_RETRY=1
VITE_QUERY_STALE_TIME_MS=30000

# Limite de resultados da busca de coluna — precisa acompanhar
# CATALOG_COLUMN_SEARCH_LIMIT do server/.env (só serve para avisar, na tela,
# que a lista foi truncada pelo BFF).
VITE_COLUMN_SEARCH_LIMIT=200
