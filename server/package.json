{
  "name": "wgov0001_catalogo_dados-server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "echo 'No build step for Python server'",
    "lint": "uv run ruff check .",
    "check-types": "uv run pyright",
    "test": "uv run pytest",
    "test:coverage": "uv run pytest --cov=app --cov-report=term-missing",
    "upgrade": "uv run alembic upgrade head",
    "migrate": "uv run alembic revision --autogenerate -m",
    "dba:generate": "uv run alembic upgrade head --sql > migrations.sql && uv run python scripts/generate_dba_sql.py"
  }
}
