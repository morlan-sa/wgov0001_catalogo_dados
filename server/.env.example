# A Postgres é compartilhada por todos os apps Morlan — não é uma instância
# dedicada a este projeto. Use sempre os campos DATABASE_HOST/PORT/NAME/
# USER/PASSWORD abaixo (mesmo em dev local) — DATABASE_URL existe só como
# fallback (app/config.py monta a partir destes quando ele fica em branco) e
# normalmente não deve ser preenchido diretamente.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
# DATABASE_NAME é fixo por ambiente (nunca por projeto): mtrd1 em
# desenvolvimento, mtrh1 em homologação, mtrp1 em produção.
DATABASE_NAME=mtrd1
DATABASE_USER=user
DATABASE_PASSWORD=password
# Isolamento é por schema, não por database — a migração 0000_create_schema
# cria o schema se ele ainda não existir. O valor não é escolhido por app: é
# o domínio de negócio a que as tabelas deste app pertencem. Apps que mexem
# em tabelas do mesmo domínio compartilham o mesmo schema; confirme o nome
# do domínio com quem definiu o escopo deste projeto, não invente um nome
# exclusivo deste app.
DATABASE_SCHEMA=cur_gov
# Schema onde mora a tabela `sessao` de morlan_access (SESSION_STORE=rds
# abaixo) — o da própria Morlan Access/IAM (`cur_iam`), não o deste app.
IAM_SCHEMA=cur_iam
# DEBUG habilita comportamentos de desenvolvimento: cookie de sessão sem
# Secure e CORS aberto para localhost:5173. Deve permanecer False em
# produção.
DEBUG=True
# Só dev local (exige DEBUG=True): pula o gate ACESSO_APP enquanto o client
# Keycloak não está em TRUSTED_SERVICE_CLIENTS da Morlan Access.
ACCESS_GATE_DISABLED=False
# Só dev local, sem Keycloak (exige DEBUG=True; com DEBUG=False o app recusa
# subir): toda requisição vira o usuário simulado abaixo, sem login nem gate.
# NUNCA ligue em homologação/produção.
DEV_AUTH_BYPASS=False
DEV_USER_CODIGO=dev.local
DEV_USER_NOME=Usuário de Desenvolvimento
DEV_USER_EMAIL=dev.local@example.com
DEV_USER_ROLES=dev

FRONTEND_URL=http://localhost:5173

# Keycloak/OIDC (BFF via morlan-access-lib, ver app/main.py) — preencha com
# os valores reais do realm/client cadastrados para este projeto.
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/morlan
# Um client por aplicação — o valor real vem de quem administra o Keycloak.
KEYCLOAK_CLIENT_ID=wgov0001_catalogo_dados
KEYCLOAK_CLIENT_SECRET=change_this_client_secret
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Claims extras do token do Keycloak a repassar pra frente — em branco por
# padrão. Lista separada por vírgula (ex.: departmentNumber,employeeType).
KEYCLOAK_EXTRA_CLAIMS=
# Base interna de discovery quando difere da pública (ex.: Keycloak
# acessado por um hostname interno do Docker) — deixe em branco se não
# houver essa diferença.
OIDC_INTERNAL_ISSUER=
SESSION_SECRET=change_this_session_secret
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
# Store de sessão server-side: "rds" (default — tabela `sessao` em
# IAM_SCHEMA acima, sem infra extra) ou "redis" (golden path em produção,
# Amazon ElastiCache — fail-closed: Redis fora do ar vira sessão não
# resolvida, nunca derruba a aplicação). Este template roda em "rds"; mudar
# pra "redis" exige reinstalar o pacote `redis` (removido de
# pyproject.toml) e preencher SESSION_REDIS_HOST (os demais têm default
# sensato).
SESSION_STORE=rds
SESSION_REDIS_HOST=
SESSION_REDIS_PORT=6379
SESSION_REDIS_DB=0
SESSION_REDIS_TLS=True
SESSION_REDIS_AUTH=

# Nível 3 (funcionalidades, opcional) — Morlan Access API centralizada.
# Deixe em branco para não usar (nenhuma rota/dependência de
# funcionalidades é habilitada neste template por padrão).
MORLAN_ACCESS_API_URL=
MORLAN_ACCESS_SISTEMA=WGOV0001-CATALOGO-DADOS

# Pool do engine assíncrono (app/db/engine.py)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

LOG_LEVEL=INFO
# cur_tin.log_exec_web é uma tabela compartilhada entre todos os apps Morlan
# (schema/tabela padronizados pela própria dh-helper-log, infra já existente
# — não é criada pela migração deste template). LOG_DB_ENABLED=true exige
# que ela já exista.
LOG_DB_ENABLED=false
LOG_DB_MIN_LEVEL=WARNING
LOG_DB_BATCH_SIZE=50
LOG_DB_FLUSH_INTERVAL_SECONDS=2.0
# Identidade deste app, gravada em toda linha de cur_tin.log_exec_web.
# Escolha um nome próprio deste projeto, nunca reaproveite o de outro app.
APP_NAME=wgov0001

# Fonte do catálogo — qual banco o portal navega, SEMPRE SOMENTE LEITURA:
#   postgres → o Postgres configurado em DATABASE_* acima (pg_catalog)
#   db2      → o DB2 abaixo (SYSCAT.*, app/db/db2.py) — é o padrão se omitido
CATALOG_SOURCE=db2

# DB2 — só usado (e só exigido) com CATALOG_SOURCE=db2.
# Usuário e senha são digitados por você — nunca commite o `.env`.
DB2_HOST=db2dev.morlan.local
# Porta do DB2 de desenvolvimento (a do PoC original; confirme a de outros ambientes).
DB2_PORT=60000
DB2_DATABASE=mdb01
DB2_USER=
DB2_PASSWORD=
# 1208 = UTF-8; sem isso os acentos de REMARKS chegam como U+FFFD.
DB2_CODEPAGE=1208

# Cache em memória das leituras do catálogo, em segundos (0 desliga): metadados
# e medições de saúde (varrem dados, então valem mais). Conexões do engine de
# leitura do catálogo (CATALOG_SOURCE=postgres) — acompanhe HEALTH_CONCURRENCY.
CATALOG_CACHE_TTL_SECONDS=300
CATALOG_HEALTH_CACHE_TTL_SECONDS=1800
CATALOG_POOL_SIZE=12

# Política de saúde dos dados e limites do catálogo (valores padrão).
CATALOG_COLUMN_SEARCH_LIMIT=200
COMPLETUDE_LIMIAR_EXCELENTE=90
COMPLETUDE_LIMIAR_BOM=70
# Colunas de auditoria/governança, fora do cálculo de completude.
AUDIT_COLUMNS=NM_ORIGEM_GRAVACAO,DT_GRAV_DADOS,NM_ORIGEM_ALTERACAO,DT_ATU_DADOS,IN_ATIVO,DS_HASH_LINHA
HEALTH_CONCURRENCY=10
# Saúde do legado: amostra das menores tabelas de cada schema.
LEGACY_HEALTH_CONCURRENCY=8
LEGACY_SAMPLE_SIZE=5
LEGACY_CANDIDATE_POOL=20
LEGACY_QUERY_TIMEOUT_SECONDS=5.0
